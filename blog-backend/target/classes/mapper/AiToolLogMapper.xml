<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blog.mapper.AiToolLogMapper">

    <resultMap id="BaseResultMap" type="com.blog.entity.AiToolLog">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="message_id" property="messageId"/>
        <result column="tool_name" property="toolName"/>
        <result column="tool_input" property="toolInput"/>
        <result column="tool_output" property="toolOutput"/>
        <result column="duration" property="duration"/>
        <result column="status" property="status"/>
        <result column="error_msg" property="errorMsg"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, session_id, message_id, tool_name, tool_input, tool_output, duration, status, error_msg, create_time
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_tool_log (session_id, message_id, tool_name, tool_input, tool_output, duration, status, error_msg, create_time)
        VALUES (#{sessionId}, #{messageId}, #{toolName}, #{toolInput}, #{toolOutput}, #{duration}, #{status}, #{errorMsg}, NOW())
    </insert>

    <select id="selectRecent" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ai_tool_log
        ORDER BY create_time DESC
        LIMIT #{limit}
    </select>

</mapper>
